diff --git a/include/rex/kernel/xboxkrnl/io.h b/include/rex/kernel/xboxkrnl/io.h
new file mode 100644
index 0000000..24ca9b4
--- /dev/null
+++ b/include/rex/kernel/xboxkrnl/io.h
@@ -0,0 +1,27 @@
+#pragma once
+
+// Generic observer adapted from Shiftglue SDK commit
+// 2db68133de6ec609c275fd8707316a240dd980e5 under its BSD 3-Clause license.
+// Copyright (c) 2026 Tom Clay; portions derived from Xenia contributors.
+// See the SDK root LICENSE for the complete notice and license terms.
+
+#include <string_view>
+
+namespace rex::kernel::xboxkrnl {
+
+// Receives the translated guest path of each NtCreateFile/NtOpenFile attempt
+// with valid object attributes, including calls through function pointers.
+// This is called before path validation and resolution, so it does not imply
+// the file exists or the open succeeded. Attribute-relative paths stay relative.
+//
+// Runs inline on the calling guest thread. The string_view is borrowed and
+// remains valid only until the callback returns. The callback must be cheap,
+// must not throw, and must not call back into the guest file system.
+//
+// Setting nullptr prevents new loads of the observer, but does not drain a
+// callback that another thread already loaded. Callback code and any state it
+// accesses must remain alive until calling guest threads have stopped.
+using GuestFileOpenObserver = void (*)(std::string_view guest_path);
+void SetGuestFileOpenObserver(GuestFileOpenObserver observer);
+
+}  // namespace rex::kernel::xboxkrnl
