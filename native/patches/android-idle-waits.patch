diff --git a/src/core/threading_posix.cpp b/src/core/threading_posix.cpp
index 90b88a9..25f772f 100644
--- a/src/core/threading_posix.cpp
+++ b/src/core/threading_posix.cpp
@@ -426,9 +426,13 @@ class PosixConditionBase {
       if (timeout == std::chrono::milliseconds::max()) {
         std::this_thread::sleep_for(std::chrono::milliseconds(1));
       } else {
-        auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(end_time - now);
-        auto sleep_time = std::min(remaining, std::chrono::milliseconds(1));
-        std::this_thread::sleep_for(sleep_time);
+        // Preserve sub-millisecond precision (Shiftglue SDK 0d85db45,
+        // arcanite24, BSD 3-Clause).
+        // Alertable waits use 1 ms slices; rounding their remaining time down
+        // to whole milliseconds turns most of each slice into a busy wait.
+        auto remaining = end_time - now;
+        std::this_thread::sleep_for(std::min<std::chrono::steady_clock::duration>(
+            remaining, std::chrono::milliseconds(1)));
       }
     }
   }
