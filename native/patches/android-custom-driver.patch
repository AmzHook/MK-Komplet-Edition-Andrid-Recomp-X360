                       "Name of custom Vulkan driver library file (Adreno Tools)");
 
+REXCVAR_DEFINE_STRING(adreno_hook_path, "", "UI/Vulkan", "Private APK directory containing AdrenoTools hook libraries");
+REXCVAR_DEFINE_STRING(adreno_tmp_path, "", "UI/Vulkan", "Writable cache directory for the Android 9 AdrenoTools loader");
+
+#if REX_PLATFORM_ANDROID
+namespace {
+// Use the documented AdrenoTools API, rather than loading a driver HAL as a
+// Vulkan loader. The hook code must remain loaded for the loader's lifetime.
+bool LoadAdrenoLoader(rex::platform::DynamicLibrary& loader, std::string directory, const std::string& name) {
+  const std::string hooks = REXCVAR_GET(adreno_hook_path);
+  const std::string temporary = REXCVAR_GET(adreno_tmp_path);
+  if (hooks.empty() || temporary.empty() || directory.empty() || name.empty()) return false;
+  if (directory.back() != '/') directory += '/';
+  const std::filesystem::path requested = std::filesystem::path(directory) / name;
+  std::error_code file_error;
+  if (!std::filesystem::is_regular_file(requested, file_error)) return false;
+  void* tools = dlopen((std::filesystem::path(hooks) / "libadrenotools.so").c_str(), RTLD_NOW | RTLD_LOCAL);
+  if (!tools) { REXLOG_WARN("MK graphics driver: AdrenoTools unavailable: {}", dlerror()); return false; }
+  using OpenLoader = void* (*)(int, int, const char*, const char*, const char*, const char*, const char*, void**);
+  auto open = reinterpret_cast<OpenLoader>(dlsym(tools, "adrenotools_open_libvulkan"));
+  if (!open) { dlclose(tools); return false; }
+  REXLOG_INFO("MK graphics driver: requested custom library={}", requested.string());
+  void* handle = open(RTLD_NOW, 1, temporary.c_str(), hooks.c_str(), directory.c_str(), name.c_str(), nullptr, nullptr);
+  if (!handle) { REXLOG_WARN("MK graphics driver: AdrenoTools loader failed; using system driver"); return false; }
+  if (!dlsym(handle, "vkGetInstanceProcAddr") || !dlsym(handle, "vkDestroyInstance")) { dlclose(handle); return false; }
+  loader.Adopt(handle);
+  // A prepared loader can internally use the system driver. Actual Vulkan
+  // device/driver properties are logged separately after initialization.
+  REXLOG_INFO("MK graphics driver: Vulkan loader prepared through AdrenoTools; request is not proof of active driver");
+  return true;
+}
+}
+#endif
