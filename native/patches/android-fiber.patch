--- /dev/null
+++ b/src/core/fiber_android_aarch64.S
@@ -0,0 +1,80 @@
+/*
+ * Android AAPCS64 cooperative fiber context switch.
+ * Copyright (c) 2026 naughtybear-restuff-android port.
+ * Copyright (c) 2026 Tom Clay <tomc@tctechstuff.com>.
+ * BSD 3-Clause License; see LICENSE in the SDK root.
+ *
+ * Adapted from the Android fiber overlay carried by ForzaHorizon2Recomp:
+ * github.com/gerisson1996/ForzaHorizon2Recomp-Android-RexGlue
+ * commit ffab1cc36823a98686b3b83028f493f64376d834.
+ * FPCR/FPSR preservation follows the BSD ReXGlue/ShiftGlue ARM64 backend:
+ * github.com/deivid22srk/shiftglue-sdk
+ * commit 404fa7eecd4d1900d6b06b261b2eb352d4ad0642.
+ *
+ * Layout is checked by the explicit context in fiber_posix.cpp.
+ * x0: context to save; x1: context to restore. x9/x10 are call-clobbered.
+ * x18 remains untouched: it belongs to the current Android OS thread.
+ */
+#if !defined(__ANDROID__) || !defined(__aarch64__)
+#error "fiber_android_aarch64.S requires Android AArch64"
+#endif
+
+.text
+.p2align 4
+.global rex_fiber_switch_aarch64
+.hidden rex_fiber_switch_aarch64
+.type rex_fiber_switch_aarch64, %function
+rex_fiber_switch_aarch64:
+    .cfi_startproc
+    hint #34                         // BTI c on supporting CPUs; NOP otherwise.
+    stp x19, x20, [x0, #0]
+    stp x21, x22, [x0, #16]
+    stp x23, x24, [x0, #32]
+    stp x25, x26, [x0, #48]
+    stp x27, x28, [x0, #64]
+    stp x29, x30, [x0, #80]
+    mov x9, sp
+    str x9, [x0, #96]
+    stp d8, d9, [x0, #104]
+    stp d10, d11, [x0, #120]
+    stp d12, d13, [x0, #136]
+    stp d14, d15, [x0, #152]
+    mrs x9, fpcr
+    mrs x10, fpsr
+    stp x9, x10, [x0, #168]
+
+    .cfi_undefined x30                // Context restoration is an unwind boundary.
+    ldp x19, x20, [x1, #0]
+    ldp x21, x22, [x1, #16]
+    ldp x23, x24, [x1, #32]
+    ldp x25, x26, [x1, #48]
+    ldp x27, x28, [x1, #64]
+    ldp x29, x30, [x1, #80]
+    ldp d8, d9, [x1, #104]
+    ldp d10, d11, [x1, #120]
+    ldp d12, d13, [x1, #136]
+    ldp d14, d15, [x1, #152]
+    ldp x9, x10, [x1, #168]
+    msr fpcr, x9
+    msr fpsr, x10
+    ldr x9, [x1, #96]
+    mov sp, x9
+    ret
+    .cfi_endproc
+.size rex_fiber_switch_aarch64, .-rex_fiber_switch_aarch64
+
+// Initial entry uses a real call to the C++ trampoline and an explicit
+// unwind root, rather than fabricating a C++ frame with a self-return LR.
+.p2align 4
+.global rex_fiber_start_aarch64
+.hidden rex_fiber_start_aarch64
+.type rex_fiber_start_aarch64, %function
+rex_fiber_start_aarch64:
+    .cfi_startproc
+    .cfi_undefined x30
+    hint #34
+    blr x19
+    brk #0                           // Defensive trap if the trampoline returns.
+    .cfi_endproc
+.size rex_fiber_start_aarch64, .-rex_fiber_start_aarch64
+.section .note.GNU-stack,"",%progbits
